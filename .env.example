ASTER_HTTP_ADDR=:8080
ASTER_DATABASE_URL=postgres://aster:aster@localhost:5432/aster?sslmode=disable
ASTER_TEST_DATABASE_URL=postgres://aster:aster@localhost:5432/aster_test?sslmode=disable
ASTER_ACCESS_TOKEN_TTL=15m
ASTER_REFRESH_TOKEN_TTL=720h
ASTER_SHUTDOWN_TIMEOUT=10s
ASTER_GATEWAY_URL=ws://localhost:8080/gateway/v1
ASTER_GATEWAY_HEARTBEAT_INTERVAL=45s
ASTER_GATEWAY_IDENTIFY_TIMEOUT=10s
ASTER_GATEWAY_SESSION_RETENTION=2m
ASTER_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
ASTER_AUTO_MIGRATE=true
# Attachments are disabled unless an S3-compatible Object Storage is configured.
ASTER_STORAGE_ENDPOINT=http://localhost:9000
ASTER_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
ASTER_STORAGE_REGION=us-east-1
ASTER_STORAGE_BUCKET=aster
ASTER_STORAGE_ACCESS_KEY=aster
ASTER_STORAGE_SECRET_KEY=aster-secret
ASTER_STORAGE_PATH_STYLE=true
# Voice channels are disabled unless a LiveKit server is configured.
ASTER_VOICE_LIVEKIT_URL=ws://localhost:7880
ASTER_VOICE_LIVEKIT_API_KEY=devkey
ASTER_VOICE_LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-0000
# Google Login is disabled unless a Google OAuth client is configured.
# ASTER_GOOGLE_REDIRECT_URL must be registered with Google as an authorized redirect URI.
# ASTER_GOOGLE_CLIENT_ID=
# ASTER_GOOGLE_CLIENT_SECRET=
# ASTER_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Email verification and password reset are disabled unless an SMTP server is configured.
# ASTER_SMTP_TLS is starttls (default), tls or none (local development only).
# ASTER_SMTP_ADDR=localhost:1025
# ASTER_SMTP_FROM=Aster <no-reply@example.com>
# ASTER_SMTP_USERNAME=
# ASTER_SMTP_PASSWORD=
# ASTER_SMTP_TLS=none
